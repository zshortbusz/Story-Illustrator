# ==============================================================================
# Automated Story Illustrator (ASI) - Environment Configuration
# Copy this file to .env and customize as needed.
# ==============================================================================

# --- LLM API Backend (Phase 1: Analysis & Prompt Synthesis) ---
# Default local LM Studio server
LM_STUDIO_URL=http://127.0.0.1:1234/v1
# Optional: Set API Key if using an authenticated local gateway or remote OpenAI-compatible provider
# LM_STUDIO_API_KEY=

# --- Image Diffusion Backend (Phase 2: Rendering) ---
# Default local ComfyUI server
COMFY_URL=http://127.0.0.1:8188

# --- Default Diffusion Workflow ---
# Located under workflows/ (e.g. animab.json, sdxl_base.json, flux_dev.json)
DEFAULT_WORKFLOW=animab.json

# --- Global Style Presets Path (Optional Override) ---
# GLOBAL_STYLES_PATH=config/global_styles.json

# --- Headless / Agentic Execution Settings ---
# Set to '1' or 'true' to enable dry-run mock mode for automated testing without GPU
# ASI_MOCK_MODE=0
