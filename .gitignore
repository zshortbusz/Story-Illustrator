# =============================================================================
# Automated Story Illustrator (ASI) - Git Ignore Configuration
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
venv.bak/
env.bak/

# IDE / Editor configuration
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# User projects (keep reference sample project the_rust_forest)
projects/*
!projects/the_rust_forest/
!projects/the_rust_forest/**
tests/artifacts/
scratch/
*.log

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
